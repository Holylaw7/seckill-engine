# Docker Compose local/demo overrides.
# Copy to .env and replace every value before using a shared or production-like environment.

MYSQL_ROOT_PASSWORD=seckill-root
TZ=Asia/Shanghai

SECKILL_JWT_SECRET=seckill-engine-dev-secret-change-me
CANARY_ENABLED=true
CANARY_WEIGHT=5
CANARY_CONTROL_ENABLED=true
CANARY_CONTROL_TOKEN=dev-canary-token

ORDER_SERVICE_SECRET=dev-order-secret
INVENTORY_SERVICE_SECRET=dev-inventory-secret
INTERNAL_ADMIN_SECRET=dev-admin-secret
MOCK_CHANNEL_SECRET=mock-channel-secret
